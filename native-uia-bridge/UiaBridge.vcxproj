<?xml version="1.0" encoding="utf-8"?>
<!--
  x64|Release and Win32|Release — a 64-bit injector cannot validly CreateRemoteThread into a
  32-bit (WOW64) target process (the resolved LoadLibraryW address is meaningless in the target's
  address space), so the DLL's bitness must match the target process's bitness. Both are built;
  the plugin picks the matching pair at runtime based on the target's actual bitness (see
  src/attach.ts).
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1E9D8C2-4F3B-4B7E-9C1A-2D6E8F0A1B2C}</ProjectGuid>
    <RootNamespace>UiaBridge</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <TargetName>appium-uia-bridge</TargetName>
    <OutDir Condition="'$(Platform)'=='x64'">$(SolutionDir)..\native\win-x64\</OutDir>
    <OutDir Condition="'$(Platform)'=='Win32'">$(SolutionDir)..\native\win-x86\</OutDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Static CRT (/MT, not /MD): this DLL gets copied as a prebuilt binary onto target
           machines that never ran this build (see build.bat / README's deployment flow) — a
           dynamically-linked CRT would depend on the VC++ Redistributable being pre-installed
           there, which isn't a safe assumption for an arbitrary customer/legacy-app machine.
           Statically linking removes that whole failure class (observed in practice: LoadLibraryW
           returning NULL in the target process with no other error, consistent with the loader
           failing to resolve vcruntime140.dll/msvcp140.dll on a machine without the redist). -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- No exports needed: appium-uia-bridge-injector.exe injects via plain
           CreateRemoteThread+LoadLibraryW, which runs DllMain automatically — DllMain.cpp's
           DLL_PROCESS_ATTACH handler does the rest (see AttachWorker). -->
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="AccessibleTree.cpp" />
    <ClCompile Include="DllMain.cpp" />
    <ClCompile Include="ElementRegistry.cpp" />
    <ClCompile Include="ProviderElement.cpp" />
    <ClCompile Include="ProviderRoot.cpp" />
    <ClCompile Include="WindowSubclass.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="AccessibleTree.h" />
    <ClInclude Include="ComPtr.h" />
    <ClInclude Include="ElementRegistry.h" />
    <ClInclude Include="ProviderElement.h" />
    <ClInclude Include="ProviderRoot.h" />
    <ClInclude Include="UiaMapping.h" />
    <ClInclude Include="WindowSubclass.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
